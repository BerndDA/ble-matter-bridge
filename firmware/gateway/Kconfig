mainmenu "BLE-to-Matter-over-Thread Gateway"

config BRIDGE_TEMPERATURE_SENSOR_BRIDGED_DEVICE
	bool "Support for Temperature Sensor bridged device"
	default y

config BRIDGE_HUMIDITY_SENSOR_BRIDGED_DEVICE
	bool "Support for Humidity Sensor bridged device"
	default y

# The gateway always bridges real Bluetooth LE devices; the simulated providers of
# the original sample were removed. The symbol is kept because the bridge core
# code uses it to enable the Bluetooth LE parts.
config BRIDGED_DEVICE_BT
	bool
	default y

config BT_CENTRAL
	default y

config BT_SCAN
	default y

config BT_SCAN_FILTER_ENABLE
	default y

# Configure how many Bluetooth LE service UUIDs the bridge can scan for.
config BT_SCAN_UUID_CNT
	default 2

config BT_SCAN_ADDRESS_CNT
	default 1

config BT_GATT_CLIENT
	default y

config BT_GATT_DM
	default y

config BT_EXT_ADV
	default y

config BT_SMP
	default y

if BT_SMP

config BT_SETTINGS
	default y

# Use two Bluetooth LE identities. The first one is used by the peripheral for Matter service
# advertising purposes, and the other is used by the bridge central.
config BT_ID_MAX
	default 2

config BT_EXT_ADV_LEGACY_SUPPORT
	default y

endif

config BRIDGE_BLE_DEVICE_POLLING_INTERVAL
	int "BLE humidity measurement readout polling interval in ms"
	default 3000

if BRIDGE_TEMPERATURE_SENSOR_BRIDGED_DEVICE

# Matter TemperatureMeasurement uses 0.01 degC. (The original sample used -20/60, i.e. -0.20..0.60 degC.)
config BRIDGE_TEMPERATURE_SENSOR_MIN_MEASURED_VALUE
	int "Minimum measured value of bridged temperature sensors (0.01 degC)"
	default -4000

config BRIDGE_TEMPERATURE_SENSOR_MAX_MEASURED_VALUE
	int "Maximum measured value of bridged temperature sensors (0.01 degC)"
	default 12500

endif

if BRIDGE_HUMIDITY_SENSOR_BRIDGED_DEVICE

# Matter RelativeHumidityMeasurement uses 0.01 %. (The original sample used 0/100, i.e. 0..1 %.)
config BRIDGE_HUMIDITY_SENSOR_MIN_MEASURED_VALUE
	int "Minimum measured value of bridged humidity sensors (0.01 %)"
	default 0

config BRIDGE_HUMIDITY_SENSOR_MAX_MEASURED_VALUE
	int "Maximum measured value of bridged humidity sensors (0.01 %)"
	default 10000

endif

# Enable Read Client functionality for all build configurations.
config CHIP_ENABLE_READ_CLIENT
	default y

config NCS_SAMPLE_MATTER_PERSISTENT_STORAGE
	default y

menu "Gateway sensor scanner"

config GATEWAY_SENSOR_SCAN_INTERVAL
	int "Background scan interval (x0.625 ms)"
	default 160
	help
	  Time between scan windows of the background passive scan for BTHome sensors.
	  Default: 160 (100 ms).

config GATEWAY_SENSOR_SCAN_WINDOW
	int "Background scan window (x0.625 ms)"
	default 40
	help
	  Listening time per scan interval. Keep it well below the interval so Thread
	  keeps enough radio time. Default: 40 (25 ms, 25 % duty cycle).

config GATEWAY_SENSOR_SCAN_RETRY_MS
	int "Background scan restart check interval (ms)"
	default 2000

config GATEWAY_SENSOR_SEEN_MAX
	int "Number of sensors kept in the 'heard' table"
	default 16

config GATEWAY_SENSOR_SCAN_PAUSE_CONNECT_MS
	int "Background scan pause while a GATT connection is being created (ms)"
	default 5000

config GATEWAY_BTHOME_AUTO_ADD
	bool "Add BTHome sensors to Matter automatically"
	default y
	help
	  Add a sensor as a Temperature Sensor and a Humidity Sensor endpoint on its
	  first BTHome packet with measurements. Removed sensors are ignored from then
	  on (shell: gateway remove / gateway unignore).

config GATEWAY_BTHOME_MAX_SENSORS
	int "Maximum number of bridged BTHome devices (sensors and thermostats)"
	default 10
	help
	  Each device uses one bridge provider; a sensor uses two dynamic
	  endpoints, a thermostat one. See BRIDGE_MAX_BRIDGED_DEVICES_NUMBER and
	  BRIDGE_MAX_DYNAMIC_ENDPOINTS_NUMBER.

config GATEWAY_EQ3_NAME_WAIT_S
	int "Wait this long for a new eQ-3 thermostat's name before adding it (s)"
	default 20
	range 0 120
	help
	  A renamed eQ-3 thermostat airs "eQ3-<name>" in its scan responses; it is
	  added with the node label "<name>", which controllers take as the initial
	  name. While waiting the background scan runs actively. If no name arrives
	  in time, or the unit has the default name, the label is "Thermostat 3F02".
	  0 adds thermostats at once with the default label.

config GATEWAY_EQ3_NAME_RETRY_MIN
	int "Look again for the names of thermostats on the generated label (min)"
	default 10
	range 0 1440
	help
	  A thermostat whose name wasn't heard when it was added keeps the label
	  "Thermostat 3F02". Every this many minutes the background scan runs
	  actively for GATEWAY_EQ3_NAME_WAIT_S; once the name is heard, the label
	  changes to it and is stored. A label set by the controller is kept.
	  0 turns the search off.

config GATEWAY_BTHOME_IGNORE_MAX
	int "Maximum number of ignored BTHome sensor addresses"
	default 8

config GATEWAY_BTHOME_UNREACHABLE_TIMEOUT_S
	int "Report a sensor unreachable after this many seconds without packets"
	default 600

config GATEWAY_BTHOME_BATTERY_WARNING_PCT
	int "Battery level reported as low (%)"
	default 20
	help
	  At or below this level, the Power Source cluster reports
	  BatChargeLevel Warning.

config GATEWAY_BTHOME_BATTERY_CRITICAL_PCT
	int "Battery level reported as critical (%)"
	default 10
	help
	  At or below this level, the Power Source cluster reports
	  BatChargeLevel Critical and BatReplacementNeeded.

config GATEWAY_BTHOME_QUEUE_SIZE
	int "Readings queued between the Bluetooth and Matter threads"
	default 8

config GATEWAY_IDENTITY_FROM_CHIP_ID
	bool "Derive the Matter identity from the chip ID"
	default y
	depends on CHIP_FACTORY_DATA
	# The SPAKE2+ verifier is computed on the device (src/crypto/PSASpake2p.cpp in Matter:
	# PBKDF2 from a password key into a derived SPAKE2+ key pair, whose public part is the verifier).
	select PSA_WANT_ALG_PBKDF2_HMAC
	select PSA_WANT_KEY_TYPE_PASSWORD
	select PSA_WANT_KEY_TYPE_SPAKE2P_KEY_PAIR_DERIVE
	select PSA_WANT_KEY_TYPE_SPAKE2P_KEY_PAIR_EXPORT
	help
	  Serial number, discriminator, setup code, SPAKE2+ salt and verifier and
	  the rotating device ID are derived from FICR DEVICEID at boot instead of
	  read from the factory data, so one image gives every board its own
	  identity (src/identity/chip_id_identity.h). `make identity` prints the
	  same codes. Certificates, vendor and product still come from the
	  factory data.

config GATEWAY_UF2_BOOTLOADER_CMD
	bool "Shell command to restart into the UF2 bootloader"
	default y if BOARD_PROMICRO_NRF52840_NRF52840_UF2
	help
	  "gateway bootloader" sets GPREGRET to 0x57, which the Adafruit UF2
	  bootloader takes as "stay in UF2 mode", and restarts. make flash
	  BOARD=promicro-uf2 uses it, so no double tap on RST is needed.

module = GATEWAY_SENSOR_SCANNER
module-str = Gateway sensor scanner
source "subsys/logging/Kconfig.template.log_config"

config GATEWAY_EQ3_TARGET_SETS_MANUAL
	bool "Setting a target switches the eQ-3 thermostat to manual mode"
	default y
	help
	  Sends 40 <manual | target> instead of 41 <target>, so the target
	  stays until the next change instead of only until the next switch
	  point of the thermostat's weekly schedule.

config GATEWAY_EQ3_QUEUE_SIZE
	int "eQ-3 commands that can wait while one runs"
	default 8
	help
	  Commands run one at a time, about 10 s each. A scene that changes
	  every thermostat queues one command per thermostat.

config GATEWAY_EQ3_ATTEMPTS
	int "Attempts per eQ-3 thermostat command"
	default 3

config GATEWAY_EQ3_ATTEMPT_TIMEOUT_S
	int "Time limit for one eQ-3 command attempt, connection included (s)"
	default 20

config GATEWAY_EQ3_CONNECT_TIMEOUT_MS
	int "Time to find the thermostat's advertisement when connecting (ms)"
	default 10000
	help
	  The thermostat advertises about once a second, but with Thread
	  sharing the radio many advertisements are missed: in a first test,
	  two 5 s windows passed without one.

module = GATEWAY_EQ3
module-str = Gateway eQ-3 thermostat client
source "subsys/logging/Kconfig.template.log_config"

endmenu

# Thread networking
if OPENTHREAD

choice OPENTHREAD_NORDIC_LIBRARY_CONFIGURATION
	default OPENTHREAD_NORDIC_LIBRARY_FTD
endchoice

choice OPENTHREAD_DEVICE_TYPE
	default OPENTHREAD_FTD
endchoice

endif # OPENTHREAD

