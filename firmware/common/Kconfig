#

# Enable Read Client functionality for all build configurations.
config CHIP_ENABLE_READ_CLIENT
	default y

config NCS_SAMPLE_MATTER_PERSISTENT_STORAGE
	default y

menu "Gateway common"

config GATEWAY_IDENTITY_FROM_CHIP_ID
	bool "Derive the Matter identity from the chip ID"
	default y
	depends on CHIP_FACTORY_DATA
	# The SPAKE2+ verifier is computed on the device (src/crypto/PSASpake2p.cpp in Matter:
	# PBKDF2 from a password key into a derived SPAKE2+ key pair, whose public part is the verifier).
	select PSA_WANT_ALG_PBKDF2_HMAC
	select PSA_WANT_KEY_TYPE_PASSWORD
	select PSA_WANT_KEY_TYPE_SPAKE2P_KEY_PAIR_DERIVE
	select PSA_WANT_KEY_TYPE_SPAKE2P_KEY_PAIR_EXPORT
	help
	  Serial number, discriminator, setup code, SPAKE2+ salt and verifier and
	  the rotating device ID are derived from FICR DEVICEID at boot instead of
	  read from the factory data, so one image gives every board its own
	  identity (src/identity/chip_id_identity.h). `make identity` prints the
	  same codes. Certificates, vendor and product still come from the
	  factory data.

config GATEWAY_NET_LOG
	bool "Log output over UDP for a receiver on the home network"
	default y if LOG_MODE_MINIMAL
	depends on OPENTHREAD && PRINTK
	help
	  A receiver (scripts/netlog.py, make netlog) finds the gateway through its
	  Matter mDNS records and subscribes on UDP; the gateway then sends what the
	  console shows (info and above, or debug on request) until the subscription
	  lapses. Nothing is sent without a subscriber. See src/netlog/net_log.h.
	  On by default in debug builds; release builds have no log output.

if GATEWAY_NET_LOG

config GATEWAY_NET_LOG_PORT
	int "UDP port"
	default 5140

config GATEWAY_NET_LOG_LEASE_S
	int "Subscription lifetime (s); the receiver renews it"
	default 60

config GATEWAY_NET_LOG_BUFFER
	int "Buffer for output not yet sent (bytes)"
	default 2048

config GATEWAY_NET_LOG_DATAGRAM
	int "Largest datagram payload (bytes)"
	default 480
	help
	  One datagram per 100 ms at most, so this also caps the log traffic on
	  Thread (480 bytes: about 4.8 KB/s). Larger datagrams need more 6LoWPAN
	  fragments and OpenThread message buffers.

endif # GATEWAY_NET_LOG

endmenu

# Thread networking
if OPENTHREAD

choice OPENTHREAD_NORDIC_LIBRARY_CONFIGURATION
	default OPENTHREAD_NORDIC_LIBRARY_FTD
endchoice

choice OPENTHREAD_DEVICE_TYPE
	default OPENTHREAD_FTD
endchoice

endif # OPENTHREAD

# Dummy Kconfig just to select experimental for some of the configurations.
config BRIDGE_EXPERIMENTAL
	bool
	default y if OPENTHREAD
	select EXPERIMENTAL

source "$(ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR)/config/nrfconnect/chip-module/Kconfig.features"
source "$(ZEPHYR_CONNECTEDHOMEIP_MODULE_DIR)/config/nrfconnect/chip-module/Kconfig.defaults"
rsource "core/Kconfig"
source "$(ZEPHYR_NRF_MODULE_DIR)/samples/matter/common/src/Kconfig"
source "Kconfig.zephyr"
